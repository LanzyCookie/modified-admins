local function tableFind(tbl: {any}, value: any): boolean
    if not tbl then return false end
    for _, v in ipairs(tbl) do
        if v == value then
            return true
        end
    end
    return false
end

local getPlyr = function(caller: Player, name: string)
    if not name then return {} end
    local _name = string.lower(name)

    local operands = string.split(_name, ",") or {_name}
    assert(#operands > 0, "No operands given")

    local output: {Player} = {}

    for i, v in ipairs(operands) do
        local trimmedV = v:gsub("^%s*(.-)%s*$", "%1")
        
        if trimmedV == "me" then
            table.insert(output, caller)
        elseif trimmedV == "all" then
            for _, plr in ipairs(Players:GetPlayers()) do
                table.insert(output, plr)
            end
        elseif trimmedV == "others" or trimmedV == "other" then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= caller then
                    table.insert(output, plr)
                end
            end
        elseif trimmedV == "admins" or trimmedV == "admin" then
            for _, plr in ipairs(Players:GetPlayers()) do
                if _G.tempadmins and tableFind(_G.tempadmins, plr.Name) then
                    table.insert(output, plr)
                end
            end
        elseif trimmedV == "nonadmins" or trimmedV == "nonadmin" then
            for _, plr in ipairs(Players:GetPlayers()) do
                if not _G.tempadmins or not tableFind(_G.tempadmins, plr.Name) then
                    table.insert(output, plr)
                end
            end
        else
            local plr = getPlrByUsername(trimmedV)
            if plr then
                table.insert(output, plr)
            end
        end
    end

    return output
end

-- FIXED: E function now only escapes HTML, NOT ampersand
function E(text: string)
    if not text then return "" end
    -- Don't escape & to avoid breaking the prefix
    return text:gsub('[<>"\']', {
        ['<'] = '&lt;',
        ['>'] = '&gt;',
        ['"'] = '&quot;',
        ['\''] = '&apos;',
    })
end

function F(text: string)
    if not text then return "" end
    return text:gsub(':(%w+):', function(t)
        return ({
            verified = utf8.char(0xE000),
            premium = utf8.char(0xE001),
            robux = utf8.char(0xE002)
        })[t] or (":"..t..":")
    end)
end

function C(text: string, colour: Color3)
    if not text then return "" end
    return `<font color="#{colour:ToHex()}">{text}</font>`
end

