-- Chat detection
local function getChatType(): string
    local success, result = pcall(function()
        return TextChatService.ChatVersion
    end)
    
    if success then
        if result == Enum.ChatVersion.TextChatService then
            return "TextChatService"
        elseif result == Enum.ChatVersion.LegacyChatService then
            return "LegacyChat"
        end
    end
    
    if game:GetService("Chat") then
        return "LegacyChat"
    end
    
    return "Unknown"
end

