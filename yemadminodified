local bindChatToPlyr = function(plyr: Player)
    if not plyr then return end
    
    if chatType == "TextChatService" then
        task.spawn(function()
            local chatConnection = TextChatService.OnIncomingMessage:Connect(function(message: TextChatMessage)
                if not isRunning then return end
                
                if message.TextSource and message.TextSource.UserId == plyr.UserId then
                    yemenv.events.PlayerChatted:Fire(plyr, message.Text)
                end
            end)
            
            table.insert(connections, plyr.AncestryChanged:Connect(function()
                if not plyr:IsDescendantOf(Players) then
                    chatConnection:Disconnect()
                end
            end))
        end)
        
    elseif chatType == "LegacyChat" then
        if _G.BindPlayerChatted then
            _G.BindPlayerChatted(plyr):Connect(function(msg: string)
                if not isRunning then return end
                yemenv.events.PlayerChatted:Fire(plyr, msg)
            end)
        else
            pcall(function()
                plyr.Chatted:Connect(function(msg: string)
                    if not isRunning then return end
                    yemenv.events.PlayerChatted:Fire(plyr, msg)
                end)
            end)
        end
    end

    task.wait()
    local plrRank = GetRank(plyr)
    if plrRank > 0 then
        Msg(plyr, `Welcome back {plyr.Name} you are {RankToString(plrRank)}({plrRank})`)
    end
end

